---
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
  containerClass?: string;
}

const {
  title,
  description,
  image,
  article = false,
  publishDate,
  updatedDate,
  author,
  tags,
  containerClass = "max-w-2xl",
} = Astro.props;
---

<!doctype html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      article={article}
      publishDate={publishDate}
      updatedDate={updatedDate}
      author={author}
      tags={tags}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Theme initialization (default dark/light sync)
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-surface-50 dark:bg-[#121214] text-surface-900 dark:text-surface-100 min-h-screen flex flex-col font-sans transition-colors antialiased">
    <!-- Main Content Container without Navbar, Clean & Focused -->
    <main class={`flex-1 w-full mx-auto px-6 py-12 sm:py-20 ${containerClass}`}>
      <slot />
    </main>

    <!-- Audio FX & UI Interaction Engine -->
    <script>
      import { sound } from '../utils/sound';

      function setupAudioUX() {
        // Sound toggle button sync
        const soundBtn = document.getElementById('sound-toggle-btn');
        const iconOn = document.getElementById('icon-sound-on');
        const iconOff = document.getElementById('icon-sound-off');

        function updateSoundIcons(isMuted: boolean) {
          if (isMuted) {
            iconOn?.classList.add('hidden');
            iconOff?.classList.remove('hidden');
          } else {
            iconOn?.classList.remove('hidden');
            iconOff?.classList.add('hidden');
          }
        }

        updateSoundIcons(sound.getMuted());

        if (soundBtn && !soundBtn.dataset.bound) {
          soundBtn.dataset.bound = 'true';
          soundBtn.addEventListener('click', () => {
            const isMuted = sound.toggleMute();
            updateSoundIcons(isMuted);
            if (!isMuted) sound.playClick();
          });
        }

        // Theme toggle button
        const themeBtn = document.getElementById('theme-toggle-btn');
        if (themeBtn && !themeBtn.dataset.bound) {
          themeBtn.dataset.bound = 'true';
          themeBtn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            sound.playClick();
          });
        }

        // Delegated click sound triggers
        if (!(window as any).__audioUxClickBound) {
          (window as any).__audioUxClickBound = true;
          document.body.addEventListener('click', (e) => {
            const target = (e.target as HTMLElement).closest('[data-sound]');
            if (!target) return;
            const type = target.getAttribute('data-sound');
            if (type === 'pop') sound.playPop();
            else if (type === 'click') sound.playClick();
            else if (type === 'soundboard') sound.playSoundboard();
          });
        }

        // Direct hover listener for chime ("Bali")
        document.querySelectorAll<HTMLElement>('[data-sound-hover="chime"]').forEach((el) => {
          if (!el.dataset.chimeBound) {
            el.dataset.chimeBound = 'true';
            el.addEventListener('mouseenter', () => {
              sound.playChime();
            });
          }
        });

        // Direct hover listener for pop ("Avatar Pop-out")
        document.querySelectorAll<HTMLElement>('[data-sound-hover="pop"]').forEach((el) => {
          if (!el.dataset.popBound) {
            el.dataset.popBound = 'true';
            el.addEventListener('mouseenter', () => {
              sound.playPop();
            });
          }
        });
      }

      setupAudioUX();
      document.addEventListener('astro:after-swap', setupAudioUX);
    </script>
  </body>
</html>
