---
import BaseLayout from './BaseLayout.astro';

export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  author: string;
  role: string;
  company: string;
  milestone?: string;
  tags: string[];
  readTime: string;
  ogImage?: string;
  headings?: HeadingItem[];
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  author,
  role,
  company,
  milestone,
  tags,
  readTime,
  ogImage,
  headings = [],
} = Astro.props;

const monthMatch = milestone?.match(/\d+/);
const monthNum = monthMatch ? parseInt(monthMatch[0], 10) : 1;
const backHref = `/?bulan=${monthNum}`;

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(publishDate);

// Filter h2 and h3 for Table of Contents
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={title}
  description={description}
  article={true}
  publishDate={publishDate}
  updatedDate={updatedDate}
  author={author}
  tags={tags}
  image={ogImage}
>
  <!-- Floating Reader Container (Modal Pop-up Aesthetics) -->
  <div class="relative max-w-5xl mx-auto">
    <!-- Top Action Bar (Close / Back Button) -->
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-surface-200 dark:border-surface-800">
      <a
        href={backHref}
        id="btn-back-chronicles"
        data-month-num={monthNum}
        data-back-url={backHref}
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-surface-100 dark:bg-surface-800 hover:bg-surface-200 dark:hover:bg-surface-700 text-surface-700 dark:text-surface-300 text-xs font-mono transition group"
        data-sound="click"
      >
        <span class="group-hover:-translate-x-1 transition-transform">&larr;</span>
        <span>Kembali ke Beranda</span>
        <kbd class="hidden sm:inline-block ml-1 px-1.5 py-0.5 text-[10px] bg-white dark:bg-surface-900 border border-surface-300 dark:border-surface-700 rounded text-surface-400">ESC</kbd>
      </a>

      <!-- Quick Indicator -->
      <div class="text-xs font-mono text-surface-400 flex items-center gap-2">
        <span>📖 Reader Mode</span>
        <span>&bull;</span>
        <span>{readTime}</span>
      </div>
    </div>

    <!-- Main Content Grid: Article + Right-Side Table of Contents -->
    <div class="flex flex-col lg:flex-row gap-10 items-start justify-between">
      
      <!-- Left Column: Main Article Body -->
      <article class="flex-1 max-w-3xl min-w-0 bg-white/70 dark:bg-surface-900/60 backdrop-blur-md rounded-2xl border border-surface-200 dark:border-surface-800 p-6 sm:p-10 shadow-sm">
        
        <!-- Header / Meta -->
        <header class="mb-8 pb-8 border-b border-surface-200 dark:border-surface-800">
          <div class="flex items-center gap-2 mb-3">
            {milestone && (
              <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-medium bg-brand-50 text-brand-700 dark:bg-brand-950 dark:text-brand-300 border border-brand-200 dark:border-brand-800">
                {milestone}
              </span>
            )}
            <span class="text-xs font-mono text-surface-400">
              {formattedDate} &bull; {readTime}
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-surface-900 dark:text-surface-50 leading-tight mb-4">
            {title}
          </h1>

          <p class="text-base sm:text-lg text-surface-600 dark:text-surface-300 leading-relaxed mb-6 font-normal">
            {description}
          </p>

          <!-- Author Info Card -->
          <div class="flex items-center justify-between flex-wrap gap-4 pt-4 border-t border-surface-100 dark:border-surface-800/60">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full overflow-hidden bg-gradient-to-tr from-brand-600 to-indigo-500 text-white flex items-center justify-center font-bold text-sm shadow-sm">
                <img src="/avatar.png" alt="Foto Profil" class="w-full h-full object-cover" />
              </div>
              <div>
                <div class="text-sm font-semibold text-surface-900 dark:text-surface-100">{author}</div>
                <div class="text-xs text-surface-500">{role} &bull; <strong class="text-surface-700 dark:text-surface-300 font-medium">{company}</strong></div>
              </div>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface-100 dark:bg-surface-800 text-surface-600 dark:text-surface-400">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        </header>

        <!-- Mobile TOC Accordion (Visible on small screens only) -->
        {tocHeadings.length > 0 && (
          <details class="lg:hidden mb-8 p-4 rounded-xl border border-surface-200 dark:border-surface-800 bg-surface-50 dark:bg-surface-950/50">
            <summary class="font-mono text-xs font-semibold text-surface-700 dark:text-surface-300 cursor-pointer select-none">
              📑 Daftar Isi Artikel ({tocHeadings.length} Bagian)
            </summary>
            <nav class="mt-3 space-y-1.5 pl-2 border-l-2 border-brand-500 text-xs font-mono">
              {tocHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  class={`block py-1 hover:text-brand-500 transition ${h.depth === 3 ? 'pl-3 text-surface-500' : 'text-surface-700 dark:text-surface-300 font-medium'}`}
                  data-sound="click"
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </details>
        )}

        <!-- Main Markdown Prose Content -->
        <div class="prose prose-zinc dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:scroll-mt-24 prose-a:text-brand-600 dark:prose-a:text-brand-400 prose-img:rounded-xl prose-code:font-mono">
          <slot />
        </div>

        <!-- Article Footer Share / Copy -->
        <div class="mt-14 pt-8 border-t border-surface-200 dark:border-surface-800 flex items-center justify-between flex-wrap gap-4 text-sm">
          <span class="text-surface-500 font-mono text-xs">
            Refleksi magang oleh <span class="text-surface-900 dark:text-surface-100 font-medium">{author}</span>
          </span>
          <button 
            id="copy-link-btn" 
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-100 dark:bg-surface-800 hover:bg-surface-200 dark:hover:bg-surface-700 text-surface-700 dark:text-surface-300 font-mono text-xs transition active:scale-95"
            data-sound="pop"
          >
            <span>Salin Tautan Artikel</span>
          </button>
        </div>
      </article>

      <!-- Right Column: Sticky Table of Contents (Daftar Isi) -->
      {tocHeadings.length > 0 && (
        <aside class="hidden lg:block w-64 shrink-0 sticky top-24 space-y-4">
          <div class="p-5 rounded-2xl border border-surface-200 dark:border-surface-800 bg-white/50 dark:bg-surface-900/40 backdrop-blur-sm shadow-sm">
            <div class="flex items-center justify-between mb-3 pb-2 border-b border-surface-200 dark:border-surface-800">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-surface-500 dark:text-surface-400">
                Daftar Isi
              </span>
              <span class="text-[10px] font-mono text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-950 px-1.5 py-0.5 rounded border border-brand-200 dark:border-brand-800">
                On this page
              </span>
            </div>

            <!-- TOC Links -->
            <nav id="toc-nav" class="space-y-1 text-xs font-mono max-h-[calc(100vh-160px)] overflow-y-auto pr-1">
              {tocHeadings.map((h) => (
                <a
                  href={`#${h.slug}`}
                  data-heading-id={h.slug}
                  class={`toc-link block py-1.5 px-2 rounded-md transition text-surface-600 dark:text-surface-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-surface-100 dark:hover:bg-surface-800 ${
                    h.depth === 3 ? 'pl-4 text-[11px] text-surface-500 dark:text-surface-500' : 'font-medium'
                  }`}
                  data-sound="click"
                >
                  {h.text}
                </a>
              ))}
            </nav>
          </div>

          <!-- Quick Return Card -->
          <div class="p-4 rounded-xl border border-surface-200 dark:border-surface-800 bg-surface-100/50 dark:bg-surface-900/20 text-xs font-mono text-surface-500">
            <span class="text-surface-700 dark:text-surface-300 font-medium">Tips:</span> Tekan tombol <kbd class="px-1 py-0.5 bg-white dark:bg-surface-800 border rounded text-[10px]">Esc</kbd> kapan saja untuk kembali ke beranda.
          </div>
        </aside>
      )}

    </div>
  </div>

  <!-- ScrollSpy & Keyboard Script -->
  <script>
    function setupTOCAndShortcuts() {
      const backBtn = document.getElementById('btn-back-chronicles');
      const backUrl = backBtn?.getAttribute('data-back-url') || '/';
      const monthNum = backBtn?.getAttribute('data-month-num') || '1';

      // Simpan bulan yang sedang dibaca ke localStorage
      try {
        localStorage.setItem('active_magang_bulan', monthNum);
      } catch (err) {}

      // 1. ESC key shortcut to close / go back to Home dengan bulan yang sesuai
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          window.location.href = backUrl;
        }
      });

      // 2. ScrollSpy: Highlight active heading in TOC
      const tocLinks = document.querySelectorAll('.toc-link');
      if (tocLinks.length === 0) return;

      const headingElements: HTMLElement[] = [];
      tocLinks.forEach((link) => {
        const id = link.getAttribute('data-heading-id');
        if (id) {
          const el = document.getElementById(id);
          if (el) headingElements.push(el);
        }
      });

      function onScroll() {
        const scrollPosition = window.scrollY + 140;

        let activeId = '';
        for (let i = 0; i < headingElements.length; i++) {
          const heading = headingElements[i];
          if (heading.offsetTop <= scrollPosition) {
            activeId = heading.id;
          }
        }

        tocLinks.forEach((link) => {
          const id = link.getAttribute('data-heading-id');
          if (id === activeId) {
            link.classList.add('text-brand-600', 'dark:text-brand-400', 'bg-brand-50', 'dark:bg-brand-950/60', 'font-semibold', 'border-l-2', 'border-brand-500');
            link.classList.remove('text-surface-600', 'dark:text-surface-400');
          } else {
            link.classList.remove('text-brand-600', 'dark:text-brand-400', 'bg-brand-50', 'dark:bg-brand-950/60', 'font-semibold', 'border-l-2', 'border-brand-500');
            link.classList.add('text-surface-600', 'dark:text-surface-400');
          }
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll(); // initial check

      // 3. Copy link button
      const copyBtn = document.getElementById('copy-link-btn');
      copyBtn?.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const originalText = copyBtn.innerText;
        copyBtn.innerText = 'Tautan Berhasil Disalin!';
        setTimeout(() => {
          copyBtn.innerText = originalText;
        }, 2000);
      });
    }

    setupTOCAndShortcuts();
    document.addEventListener('astro:after-swap', setupTOCAndShortcuts);
  </script>
</BaseLayout>
